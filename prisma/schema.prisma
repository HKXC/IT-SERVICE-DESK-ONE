// IT Helpdesk — Prisma Schema (six-module scope)
// PostgreSQL · Vercel Postgres compatible
// Modules: Authentication & User · Ticket · Comment & Timeline · Asset · Dashboard · Report

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js core (PrismaAdapter compatible) ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials auth (bcrypt). Null for future SSO-only users.
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  // Org relations
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Identity provider marker — keeps credentials assumptions out of session model
  identityProvider String @default("credentials") // credentials | entra-id | google | ldap | sso

  accounts      Account[]
  sessions      Session[]
  // Ticket relations
  requestedTickets Ticket[]       @relation("TicketRequester")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  comments         TicketComment[]
  timelineEvents   TicketTimelineEvent[] @relation("TimelineActor")
  // Asset relations
  assetAssignments AssetAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Org · Roles ────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique
  parentId String?
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DeptHierarchy")
  users    User[]
  tickets  Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique
  address  String?
  users    User[]
  tickets  Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Exactly three roles: User · Technician · Administrator
model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Tickets ────────────────────────────────────────────────────────────────

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketSource {
  WEB
  EMAIL
  API
  CHAT
  AI_AGENT
}

model TicketSequence {
  prefix String // INC | REQ
  year   Int
  last   Int    @default(0)

  @@id([prefix, year])
}

model Ticket {
  id          String  @id @default(cuid())
  ticketNo    String  @unique // INC-2026-000001
  title       String
  description String  @db.Text

  type     TicketType
  category String
  subcategory String?
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(NEW)

  source TicketSource @default(WEB)

  // People / org
  requesterId String
  requester   User       @relation("TicketRequester", fields: [requesterId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // Asset link
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // SLA
  slaPolicyId          String?
  slaPolicy            SLAPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  slaResponseDueAt     DateTime?
  slaResolutionDueAt   DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  slaPausedSeconds     Int       @default(0) // accumulated pause time
  slaPauseStartedAt    DateTime?
  slaResponseBreached  Boolean   @default(false)
  slaResolutionBreached Boolean  @default(false)

  comments    TicketComment[]
  attachments TicketAttachment[]
  timeline    TicketTimelineEvent[]
  pauses      SLAPauseInterval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([assetId])
  @@index([createdAt])
  @@index([slaResolutionDueAt])
}

enum CommentType {
  PUBLIC
  INTERNAL
}

model TicketComment {
  id       String      @id @default(cuid())
  ticketId String
  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User        @relation(fields: [authorId], references: [id])
  type     CommentType @default(PUBLIC)
  body     String      @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}

model TicketAttachment {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  fileSize  Int
  mimeType  String
  storageKey String // Vercel Blob / S3 key
  storageUrl String?
  uploadedBy String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketTimelineEvent {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId  String?
  actor    User?  @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  event    String // CREATED | ASSIGNED | STATUS_CHANGED | RESOLVED | CLOSED | REOPENED | PRIORITY_CHANGED
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  detail   String? @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── SLA (kept) ─────────────────────────────────────────────────────────────

model SLAPolicy {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  // Per-priority targets in minutes
  p1ResponseMin   Int @default(15)
  p1ResolutionMin Int @default(240)
  p2ResponseMin   Int @default(30)
  p2ResolutionMin Int @default(480)
  p3ResponseMin   Int @default(240)
  p3ResolutionMin Int @default(1440)
  p4ResponseMin   Int @default(480)
  p4ResolutionMin Int @default(4320)
  atRiskPercent Int @default(75)
  businessHoursId String?
  businessHours   BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  tickets Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHours {
  id        String  @id @default(cuid())
  name      String  @unique @default("Default Business Hours")
  timezone  String  @default("Asia/Bangkok")
  workingDays Json @default("[1,2,3,4,5]")
  startTime   String @default("09:00")
  endTime     String @default("18:00")
  policies    SLAPolicy[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  isRecurring Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([date])
}

model SLAPauseInterval {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  pausedAt  DateTime @default(now())
  resumedAt DateTime?
  reason    String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Assets (light) ─────────────────────────────────────────────────────────

enum AssetStatus {
  IN_STOCK
  ASSIGNED
  REPAIR
  RETIRED
}

enum AssetType {
  COMPUTER
  SERVER
  NETWORK
  PRINTER
  MOBILE
  OTHER
}

model Asset {
  id         String      @id @default(cuid())
  assetTag   String      @unique // Asset Number
  name       String
  type       AssetType   @default(OTHER)
  status     AssetStatus @default(IN_STOCK)

  serialNumber String?
  brand        String?
  model        String?

  // Current responsible user (history in AssetAssignment)
  assignedUserId String?

  tickets      Ticket[]
  history      AssetHistoryEvent[]
  assignments  AssetAssignment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([assignedUserId])
}

model AssetHistoryEvent {
  id       String @id @default(cuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event    String // CREATED | ASSIGNED | UNASSIGNED | STATUS_CHANGED | REPAIR | RETIRED | TICKET_LINKED
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  detail   String? @db.Text
  actorId  String?
  createdAt DateTime @default(now())

  @@index([assetId])
}

model AssetAssignment {
  id        String    @id @default(cuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  note      String?

  @@index([assetId])
  @@index([userId])
}

// ─── Settings ───────────────────────────────────────────────────────────────

model SystemSetting {
  key       String  @id
  value     Json
  updatedAt DateTime @updatedAt
}
