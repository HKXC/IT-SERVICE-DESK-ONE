// IT Service Desk & Asset Management Platform — Prisma Schema
// PostgreSQL · Vercel Postgres compatible
// Conventions: cuid ids, timestamptz via @db.Timestamptz where needed,
// every mutation writes AuditLog (enforced in Server Actions, not DB triggers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth.js core (PrismaAdapter compatible) ────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials auth (bcrypt). Null for future SSO-only users.
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  // Org relations
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Identity provider marker — keeps credentials assumptions out of session model
  identityProvider String @default("credentials") // credentials | entra-id | google | ldap | sso

  accounts      Account[]
  sessions      Session[]
  // Ticket relations
  requestedTickets Ticket[]       @relation("TicketRequester")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  comments         TicketComment[]
  workLogs         WorkLog[]
  timelineEvents   TicketTimelineEvent[] @relation("TimelineActor")
  // Asset relations
  assetAssignments AssetAssignment[]
  licenseAssignments LicenseAssignment[]
  // Misc
  auditLogs     AuditLog[]
  notifications Notification[]
  kbArticles    KnowledgeArticle[] @relation("KbAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── Org · RBAC ─────────────────────────────────────────────────────────────

model Department {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique
  parentId String?
  parent   Department?  @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DeptHierarchy")
  users    User[]
  assets   Asset[]
  tickets  Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Location {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String? @unique
  address  String?
  users    User[]
  assets   Asset[]
  tickets  Ticket[]
  inventoryItems InventoryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // Employee, Technician, Team Lead, Asset Officer, IT Manager, Administrator
  description String?
  isSystem    Boolean @default(false) // system roles cannot be deleted
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. ticket.create
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── Tickets ────────────────────────────────────────────────────────────────

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  REPAIR
  PROBLEM
  CHANGE_REQUEST
  ACCESS_REQUEST
}

enum TicketStatus {
  NEW
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  WAITING_USER
  WAITING_VENDOR
  WAITING_PART
  ON_HOLD
  ESCALATED
  RESOLVED
  PENDING_CONFIRMATION
  CLOSED
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum ImpactLevel {
  HIGH
  MEDIUM
  LOW
}

enum UrgencyLevel {
  HIGH
  MEDIUM
  LOW
}

enum TicketSource {
  WEB
  EMAIL
  API
  CHAT
  AI_AGENT
}

model TicketSequence {
  prefix String // INC | REQ | PRB | CHG | ACC | REP
  year   Int
  last   Int    @default(0)

  @@id([prefix, year])
}

model Ticket {
  id          String  @id @default(cuid())
  ticketNo    String  @unique // INC-2026-000001
  title       String
  description String  @db.Text

  type     TicketType
  category String
  subcategory String?
  priority TicketPriority @default(P3)
  impact   ImpactLevel    @default(MEDIUM)
  urgency  UrgencyLevel   @default(MEDIUM)
  status   TicketStatus   @default(NEW)

  source TicketSource @default(WEB)

  // People / org
  requesterId String
  requester   User       @relation("TicketRequester", fields: [requesterId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignedTeam String?

  // Asset link
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)

  // SLA
  slaPolicyId          String?
  slaPolicy            SLAPolicy? @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  slaResponseDueAt     DateTime?
  slaResolutionDueAt   DateTime?
  firstResponseAt      DateTime?
  resolvedAt           DateTime?
  closedAt             DateTime?
  slaPausedSeconds     Int       @default(0) // accumulated pause time
  slaPauseStartedAt    DateTime?
  slaResponseBreached  Boolean   @default(false)
  slaResolutionBreached Boolean  @default(false)

  // Satisfaction
  satisfactionRating Int? // 1-5

  comments    TicketComment[]
  workLogs    WorkLog[]
  attachments TicketAttachment[]
  timeline    TicketTimelineEvent[]
  pauses      SLAPauseInterval[]
  relationsFrom TicketRelation[] @relation("RelFrom")
  relationsTo   TicketRelation[] @relation("RelTo")
  stockUsage    StockTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([requesterId])
  @@index([assigneeId])
  @@index([assetId])
  @@index([createdAt])
  @@index([slaResolutionDueAt])
}

model TicketRelation {
  id          String  @id @default(cuid())
  fromTicketId String
  fromTicket   Ticket  @relation("RelFrom", fields: [fromTicketId], references: [id], onDelete: Cascade)
  toTicketId   String
  toTicket     Ticket  @relation("RelTo", fields: [toTicketId], references: [id], onDelete: Cascade)
  relationType String  @default("RELATED") // RELATED | DUPLICATE | BLOCKS | CAUSED_BY
  createdAt    DateTime @default(now())

  @@unique([fromTicketId, toTicketId])
}

enum CommentType {
  PUBLIC
  INTERNAL
}

model TicketComment {
  id       String      @id @default(cuid())
  ticketId String
  ticket   Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User        @relation(fields: [authorId], references: [id])
  type     CommentType @default(PUBLIC)
  body     String      @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
}

model WorkLog {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  title    String?
  body     String @db.Text
  timeSpentMin Int @default(0)
  // Parts used on this work log (drives stock decrement)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  quantityUsed    Int @default(0)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketAttachment {
  id        String @id @default(cuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName  String
  fileSize  Int
  mimeType  String
  storageKey String // Vercel Blob / S3 key
  storageUrl String?
  uploadedBy String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model TicketTimelineEvent {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId  String?
  actor    User?  @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  event    String // STATUS_CHANGED | COMMENT_ADDED | ASSIGNED | SLA_BREACH | ...
  fromStatus TicketStatus?
  toStatus   TicketStatus?
  detail   String? @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── SLA ────────────────────────────────────────────────────────────────────

model SLAPolicy {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  // Per-priority targets in minutes
  p1ResponseMin   Int @default(15)
  p1ResolutionMin Int @default(240)
  p2ResponseMin   Int @default(30)
  p2ResolutionMin Int @default(480)
  p3ResponseMin   Int @default(240)
  p3ResolutionMin Int @default(1440)
  p4ResponseMin   Int @default(480)
  p4ResolutionMin Int @default(4320)
  // Escalation: at-risk threshold % of target elapsed (e.g. 75)
  atRiskPercent Int @default(75)
  businessHoursId String?
  businessHours   BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  tickets Ticket[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessHours {
  id        String  @id @default(cuid())
  name      String  @unique @default("Default Business Hours")
  timezone  String  @default("Asia/Bangkok")
  // 0=Sun..6=Sat — JSON arrays of {start,end} "09:00"-"18:00"
  workingDays Json @default("[1,2,3,4,5]")
  startTime   String @default("09:00")
  endTime     String @default("18:00")
  policies    SLAPolicy[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @db.Date
  isRecurring Boolean @default(false)
  createdAt DateTime @default(now())

  @@unique([date])
}

model SLAPauseInterval {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  pausedAt  DateTime @default(now())
  resumedAt DateTime?
  reason    String? // WAITING_USER | WAITING_VENDOR | WAITING_PART
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// ─── Assets ─────────────────────────────────────────────────────────────────

enum AssetStatus {
  REQUESTED
  PURCHASED
  RECEIVED
  IN_STOCK
  ASSIGNED
  IN_USE
  REPAIR
  MAINTENANCE
  TRANSFER
  RESERVED
  LOST
  RETIRED
  DISPOSED
}

enum AssetType {
  COMPUTER
  SERVER
  NETWORK
  PRINTER
  MOBILE
  OTHER
}

model Asset {
  id         String      @id @default(cuid())
  assetTag   String      @unique
  name       String
  type       AssetType   @default(OTHER)
  category   String?
  status     AssetStatus @default(IN_STOCK)

  serialNumber String?
  manufacturer String?
  brand        String?
  model        String?

  // Specs
  cpu     String?
  ram     String?
  storage String?
  gpu     String?

  os        String?
  osVersion String?
  hostname  String?
  ipAddress String?
  macAddress String?

  purchaseDate  DateTime? @db.Date
  purchasePrice Decimal?  @db.Decimal(12, 2)
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  warrantyStart DateTime? @db.Date
  warrantyEnd   DateTime? @db.Date

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  locationId   String?
  location     Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Current assignment (denormalized pointer; history in AssetAssignment)
  assignedUserId String?
  notes          String? @db.Text

  tickets      Ticket[]
  history      AssetHistoryEvent[]
  assignments  AssetAssignment[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([departmentId])
  @@index([assignedUserId])
}

model AssetHistoryEvent {
  id       String @id @default(cuid())
  assetId  String
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event    String // RECEIVED | ASSIGNED | TRANSFERRED | REPAIR | ...
  fromStatus AssetStatus?
  toStatus   AssetStatus?
  detail   String? @db.Text
  cost     Decimal? @db.Decimal(12, 2)
  actorId  String?
  createdAt DateTime @default(now())

  @@index([assetId])
}

model AssetAssignment {
  id        String    @id @default(cuid())
  assetId   String
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  returnedAt DateTime?
  note      String?

  @@index([assetId])
  @@index([userId])
}

// ─── Inventory ──────────────────────────────────────────────────────────────

enum StockTxnType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  REPAIR_USAGE
  RETURN
}

model InventoryItem {
  id           String  @id @default(cuid())
  sku          String  @unique
  name         String
  category     String
  brand        String?
  model        String?
  quantity     Int     @default(0)
  minStock     Int     @default(5)
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  unitCost     Decimal? @db.Decimal(12, 2)
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  workLogs     WorkLog[]
  transactions StockTransaction[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model StockTransaction {
  id              String       @id @default(cuid())
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  type            StockTxnType
  quantity        Int // signed: +in / -out
  quantityBefore  Int
  quantityAfter   Int
  ticketId        String?
  ticket          Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  reason          String?
  actorId         String?
  createdAt       DateTime @default(now())

  @@index([itemId])
  @@index([ticketId])
}

// ─── Software & Licenses ────────────────────────────────────────────────────

model Software {
  id          String  @id @default(cuid())
  name        String
  vendor      String?
  version     String?
  category    String?
  licenseType String? // OEM | VOLUME | SUBSCRIPTION | OPEN_SOURCE
  description String? @db.Text
  licenses    License[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, version])
}

model License {
  id              String    @id @default(cuid())
  softwareId      String
  software        Software  @relation(fields: [softwareId], references: [id], onDelete: Cascade)
  key             String?   @unique
  seatsTotal      Int       @default(1)
  seatsUsed       Int       @default(0)
  purchaseDate    DateTime? @db.Date
  expiryDate      DateTime? @db.Date
  cost            Decimal?  @db.Decimal(12, 2)
  vendorId        String?
  vendor          Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignments     LicenseAssignment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([softwareId])
  @@index([expiryDate])
}

model LicenseAssignment {
  id         String   @id @default(cuid())
  licenseId  String
  license    License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  revokedAt  DateTime?

  @@unique([licenseId, userId])
}

// ─── Vendors ────────────────────────────────────────────────────────────────

model Vendor {
  id            String  @id @default(cuid())
  name          String  @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  taxId         String?
  assets        Asset[]
  inventoryItems InventoryItem[]
  licenses      License[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Knowledge Base ─────────────────────────────────────────────────────────

model KnowledgeCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?
  parent   KnowledgeCategory?  @relation("KbCatHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children KnowledgeCategory[] @relation("KbCatHierarchy")
  articles KnowledgeArticle[]
  createdAt DateTime @default(now())
}

model KnowledgeArticle {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  summary    String?
  body       String  @db.Text
  categoryId String?
  category   KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId   String?
  author     User?   @relation("KbAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  tags       String[] @default([])
  isPublished Boolean @default(false)
  viewCount  Int     @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

// ─── Notifications · Audit · Settings ───────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String? @db.Text
  link      String?
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String // ticket.status_changed | asset.assigned | role.updated | ...
  entity    String // Ticket | Asset | User | ...
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model SystemSetting {
  key       String  @id // priority_matrix | sla_defaults | ...
  value     Json
  updatedAt DateTime @updatedAt
}
