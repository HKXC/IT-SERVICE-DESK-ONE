# Database — PostgreSQL (Vercel Postgres or external provider)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itservicedesk?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/itservicedesk?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32-min-32-chars!!"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Storage — Vercel Blob or S3-compatible
BLOB_READ_WRITE_TOKEN=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="it-servicedesk-uploads"
S3_REGION="auto"
# "true" for most S3-compatible providers (MinIO, Neon); set "false" for AWS S3 / Cloudflare R2
S3_FORCE_PATH_STYLE="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IT Service Desk"

# Rate limiting (Upstash Redis optional — falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# SSO placeholders (future: Entra ID / Google / LDAP — see src/lib/sso.ts)
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
